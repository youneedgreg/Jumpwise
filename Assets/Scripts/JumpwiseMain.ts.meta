  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">JumpwiseMain – jump-start guide orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References: UI"}'
    - "// @input AssignableType_1 foundBatteryUI {\"hint\":\"The big 'Found battery' button + owner's manual card.\"}"
    - '// @input AssignableType_2 stepCard {"hint":"The step card and Next button."}'
    - '// @input AssignableType_3 guidance {"hint":"Chime + edge arrow for targets out of view."}'
    - '// @input AssignableType_4 audio {"hint":"Chime, spark and clamp-click cues."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References: Clamps"}'
    - '// @input AssignableType_5 clampRedA {"hint":"Red clamp used in step 1 (dead battery +)."}'
    - '// @input AssignableType_6 clampRedB {"hint":"Red clamp used in step 2 (donor battery +)."}'
    - '// @input AssignableType_7 clampBlackB {"hint":"Black clamp used in step 3 (donor battery -)."}'
    - '// @input AssignableType_8 clampBlackA {"hint":"Black clamp used in step 4 (bare-metal ground point)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References: Markers (drop zones)"}'
    - "// @input AssignableType_9 markerDeadPlus {\"hint\":\"Marker on the dead battery's + terminal (step 1).\"}"
    - "// @input AssignableType_10 markerDeadMinus {\"hint\":\"Marker on the dead battery's - terminal (never a step; flashes on a wrong drop).\"}"
    - "// @input AssignableType_11 markerDonorPlus {\"hint\":\"Marker on the donor battery's + terminal (step 2).\"}"
    - "// @input AssignableType_12 markerDonorMinus {\"hint\":\"Marker on the donor battery's - terminal (step 3).\"}"
    - '// @input AssignableType_13 markerGround {"hint":"Marker on the bare-metal ground point on the dead car (step 4)."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float dropZoneScale = 2 {"hint":"Drop zone size as a multiple of the visible ring (brief: twice its visible size).", "widget":"slider", "min":1, "max":4, "step":0.1}'
    - '// @input float warningSeconds = 4 {"hint":"Seconds the wrong-drop warning stays on the card.", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
